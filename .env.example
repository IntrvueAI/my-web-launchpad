# Browser configuration. Copy this file to .env for local development.
# Values prefixed VITE_ are public and may be included in the browser bundle.
VITE_SITE_DOWN=false
# A single email may bypass the existing 11+ availability gate.
VITE_ADMIN_BYPASS_EMAIL=founders@intrvue.ai

# Google is available by default; set false to hide it during a provider outage.
VITE_GOOGLE_SIGN_IN_ENABLED=true
# Keep email sign-up/reset/code actions off until real email delivery is verified.
VITE_EMAIL_SIGN_IN_ENABLED=false

# Server-only credentials belong in Supabase Edge Function secrets:
# ANAM_API_KEY, OPENAI_API_KEY, MMI_GUEST_LINK_SECRET,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, DEEPGRAM_API_KEY.
# Never prefix these credentials with VITE_.
# MMI_GUEST_LINK_SECRET must contain at least 32 random characters; preserve it
# after creating invitations because it signs existing links and retry credentials.

# Optional local server-side diagnostic scripts only (never browser code):
# SUPABASE_SERVICE_ROLE_KEY=
